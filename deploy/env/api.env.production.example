# Backend API production env for native IIS deployment.
# Copy to C:\Sites\SIDHKOFED\env\api.env and replace every CHANGE_ME value.
# Do not put inline comments after values.

NODE_ENV=production
APP_NAME=sidhkofed-cms
APP_PORT=4000
API_BASE_PATH=/api/v1
PUBLIC_WEBSITE_URL=https://www.example.gov.in
LOG_LEVEL=info

DATABASE_URL=postgresql://sidhkofed_app:CHANGE_ME_DB_PASSWORD@CHANGE_ME_DB_SERVER:5432/sidhkofed_cms?schema=public
DIRECT_URL=postgresql://sidhkofed_app:CHANGE_ME_DB_PASSWORD@CHANGE_ME_DB_SERVER:5432/sidhkofed_cms?schema=public
DATABASE_REPLICA_URL=
DB_POOL_MAX=10

CACHE_TTL_SECONDS=300

JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=sidhkofed-cms
REFRESH_COOKIE_NAME=sidhkofed_rt
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
PASSWORD_HASH_ROUNDS=12

SEED_SUPERADMIN_EMAIL=admin@example.gov.in
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_FIRST_LOGIN_PASSWORD
SEED_SUPERADMIN_NAME=SIDHKOFED Super Admin

STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=\\CHANGE_ME_NFS_SERVER\sidhkofed-storage
STORAGE_PUBLIC_BASE_URL=https://www.example.gov.in/api/v1/public/media
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=600

UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_DOCUMENT_MB=25
UPLOAD_MAX_DATASET_MB=15
UPLOAD_BULK_MAX_FILES=50
UPLOAD_MAX_REQUEST_MB=60
UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
UPLOAD_ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
UPLOAD_ALLOWED_DATASET_TYPES=text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
MALWARE_SCAN_ENABLED=false

EMAIL_ENABLED=false
EMAIL_FROM=SIDHKOFED CMS <no-reply@example.gov.in>
EMAIL_ENQUIRY_RECIPIENT=enquiries@example.gov.in
EMAIL_SUBJECT_PREFIX=[SIDHKOFED Enquiry]
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

CAPTCHA_PROVIDER=none
CAPTCHA_SECRET=
ENQUIRY_RATELIMIT_PER_IP_HOUR=5
ENQUIRY_RATELIMIT_PER_CONTACT_HOUR=3
IP_HASH_SALT=CHANGE_ME_RANDOM_IP_HASH_SALT

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=900
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW_SEC=900
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_UPLOAD_WINDOW_SEC=900

DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi
TRANSLATION_FALLBACK_ENABLED=false

SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_PUBLISHING_CRON=*/5 * * * *
SCHEDULER_HIGHLIGHT_CRON=*/5 * * * *
SCHEDULER_EVENT_STATUS_CRON=*/15 * * * *
SCHEDULER_DASHBOARD_REFRESH_CRON=0 * * * *
SCHEDULER_BATCH_SIZE=100
SCHEDULER_LOCK_TTL_SECONDS=600
